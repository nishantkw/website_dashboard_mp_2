# Primary PostgreSQL (local Docker, Neon, or other managed Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pmjay_dashboard

# Fallback Supabase Postgres URI
# Project Settings → Database → Connection string (URI)
SUPABASE_DB_URL=

# Optional Supabase REST (health / simple reads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Which DB to try first: postgres | supabase
DB_PRIMARY=postgres

PORT=4000
NODE_ENV=development

# Long random value required in production (openssl rand -base64 48)
JWT_SECRET=change-me-in-production
JWT_TTL_SECONDS=28800

# Session cookie. For Vercel UI + Render API use:
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
AUTH_COOKIE_NAME=pmjay_session

# Exact frontend origin(s), comma-separated. No wildcards.
# Production example: https://your-app.vercel.app
# Local: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Seed demo login users only when the users table is empty (local/dev).
# Leave unset/false on Render so production Neon is never auto-seeded.
ALLOW_DEFAULT_USER_SEED=true

# TLS: leave unset (verify certs). Set to false only if a managed DB needs it temporarily.
# DB_SSL_REJECT_UNAUTHORIZED=false

# Public /api/health stays { ok: true/false }. Set true for ops DB detail.
# HEALTH_DETAILS=true
