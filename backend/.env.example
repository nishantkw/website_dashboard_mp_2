# Primary PostgreSQL (local Docker or managed)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pmjay_dashboard

# Fallback Supabase Postgres URI
# Project Settings → Database → Connection string (URI)
SUPABASE_DB_URL=

# Optional Supabase REST (health / simple reads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Which DB to try first: postgres | supabase
DB_PRIMARY=postgres

PORT=4000
# Long random value required in production (openssl rand -base64 48)
JWT_SECRET=change-me-in-production
# Session cookie. Use COOKIE_SAMESITE=none and COOKIE_SECURE=true if the UI and API are on different HTTPS hosts.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
